# Copy to .env for local dev. Never commit .env.
# Production: these come from Vault, not a file.

# --- Postgres (direct, superuser — bootstrap and tests' privileged control only) ---
PG_SUPER_DSN=postgresql://postgres:postgres@localhost:55432/postgres

# --- Postgres (direct, migration/provisioning role) ---
PG_MIGRATE_DSN=postgresql://tenant_migrate:migrate_pw@localhost:55432/tenant_db

# --- Postgres (THROUGH PGBOUNCER — the only DSN the runtime may use) ---
# Transaction pooling. app_login is NOINHERIT and has no privileges until SET LOCAL ROLE.
PG_APP_DSN=postgresql://app_login:app_pw@localhost:56432/tenant_db

# Passwords consumed by docker/initdb bootstrap
TENANT_MIGRATE_PASSWORD=migrate_pw
APP_LOGIN_PASSWORD=app_pw

# --- Object store (Bronze) ---
S3_ENDPOINT_URL=http://localhost:59000
S3_REGION=ap-south-1
S3_ACCESS_KEY=minioadmin
S3_SECRET_KEY=minioadmin
S3_BUCKET_PREFIX=inafin-tenant
# Object Lock retention floor: CGST s.36 = 72 months from annual return due date.
BRONZE_RETENTION_DAYS=2190

# --- Kafka (the doorbell — never carries tenant business data) ---
KAFKA_BOOTSTRAP=localhost:59092
KAFKA_BATCH_TOPIC=inafin.tenant.batch_ready
KAFKA_ENABLED=true

# --- API auth (src/api/auth.py) --- placeholder token -> tenant slug map.
# NOT a security boundary; real Keycloak/JWT verification is unbuilt.
API_TENANT_TOKENS={"dev-acme-token": "acme"}

ENVIRONMENT=development
LOG_LEVEL=INFO
